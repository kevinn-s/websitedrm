use App\Enums\EventAccessType;


new #[Layout('layouts.app')] class extends Component {

    public string $activeTab = EventType::Scheduled->value;
    public string $search = '';
    public ?string $date = null;

    public function mount(): void
    {
        $this->activeTab = EventType::Scheduled->value;
    }

    public function setActiveTab(string $tab): void
    {
        if (! in_array($tab, [EventType::Scheduled->value, EventType::Annual->value], true)) {
            return;
        }

        $this->activeTab = $tab;
    }

    public function resetFilters(): void
    {
        $this->search = '';
        $this->date = null;
    }

    #[Computed]
    public function events()
    {
        $query = Event::query()
            ->with('accesses')
            ->where('type', $this->activeTab)
            ->when($this->search, function ($query) {
                $query->where('title', 'like', '%' . $this->search . '%');
            })
            ->when($this->date, function ($query) {
                $query->whereDate('date', $this->date);
            })
            ->orderBy('date', 'asc');

        return $query->get();
    }

    public function with(): array
    {
        return [
            'events' => $this->events,
        ];
    }
}
