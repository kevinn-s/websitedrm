new #[Layout('layouts.app')] class extends Component {

    public string $activeTab = EventType::Scheduled->value;
    public string $search = '';
    public $events;
    public ?string $date = null;

    public function mount(): void
    {
        $this->activeTab = EventType::Scheduled->value;
        $this->events = $this->queryEvents();
        $this->dispatch('unloading');
    }

    public function setActiveType(string $tab): void
    {
        if (! in_array($tab, [EventType::Scheduled->value, EventType::Annual->value], true)) {
            return;
        }

        $this->activeTab = $tab;
        $this->events = $this->queryEvents();
        $this->dispatch('unloading');
    }

    public function runFilters(): void
    {
        $this->events = $this->queryEvents();
        $this->search = '';
        $this->date = null;
        $this->dispatch('unloading');
    }

    public function resetFilters(): void
    {
        $this->search = '';
        $this->date = null;
        $this->events = $this->queryEvents();
        $this->dispatch('unloading');
    }

    #[Computed]
    public function queryEvents()
    {
        return Event::query()
            ->with('accesses')
            ->where('type', $this->activeTab)
            ->when($this->search, fn ($query) => $query->where('title', 'like', '%' . $this->search . '%'))
            ->when($this->date, fn ($query) => $query->whereDate('date', $this->date))
            ->orderBy('date', 'asc')
            ->get();
    }

    public function with(): array
    {
        return [
            'events' => $this->events,
        ];
    }
}
