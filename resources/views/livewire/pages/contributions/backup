use Livewire\Volt\Component;
use Livewire\Attributes\Layout;
use Livewire\WithFileUploads;

use Illuminate\Validation\Rules\Enum;

use App\Models\Donation;
use App\Enums\Status;
use App\Enums\ContributionType;

new #[Layout('layouts.app')] class extends Component {
    use WithFileUploads;

    public Status $type;
    public int $amount;
    public string $proof;

    protected function rules(): array
    {
    return [
        'type' => ['required', new Enum(ContributionType::class)],
        'amount' => [
            'required',
            'integer',
            function ($attribute, $value, $fail) {
                if ($this->type === ContributionType::Monthly && $value < 10000) {
                    $fail('Minimum nominal untuk kontribusi bulanan adalah Rp 10.000.');
                }

                if ($this->type === ContributionType::Yearly && $value < 100000) {
                    $fail('Minimum nominal untuk kontribusi tahunan adalah Rp 100.000.');
                }
            },
        ],
        'proof' => ['required', 'file', 'mimes:jpeg,png,pdf', 'max:2048'],
    ];
    }


    public function save(): void
    {
        $this->validate();
        dd($this->type);
    }
}; ?>


