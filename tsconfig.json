{
  "compilerOptions": {
        "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
        "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,

    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,

    "paths": {
      "@/*": ["./resources/js/*"]
    }
  }
}
